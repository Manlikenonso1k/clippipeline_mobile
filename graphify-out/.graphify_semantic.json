    {
      "id": "instructions",
      "label": "Two-Project Build Blueprint",
      "file_type": "document",
      "source_file": "C:\\Users\\Tenstrings Music Ins\\Documents\\clippipeline-mobile\\instructions.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Server owns truth and time because clients cannot be trusted with countdowns/money; money as integer minor units to avoid float errors; multi-tenant isolation resolved from token never request param to prevent cross-tenant leakage; roles assigned by business not self-selected; additive backend to avoid breaking live systems."
    },
    {
