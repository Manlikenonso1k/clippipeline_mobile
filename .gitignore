# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# graphify generated output
graphify-out/

# dev server logs
expo-web.log
expo-web.error.log
*.error.log

# lockfile excluded from EAS build (npm version drift); EAS uses npm install
package-lock.json

# Firebase service-account keys (SECRET — never commit)
*-firebase-adminsdk-*.json
firebase-adminsdk*.json
service-account*.json
