{
  "expo": {
    "name": "ClipPipeline",
    "slug": "clippipeline-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/expo.icon/Assets/icon-active.png",
    "scheme": "clippipelinemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.codebynonso.clippipeline",
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/expo.icon/Assets/icon-active.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0E12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#7C5CFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4d666c56-1029-47d1-bf3f-6f0cb330a5d5"
      }
    },
    "owner": "codebynonso"
  }
}
